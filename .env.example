# Copy to .env (gitignored, chmod 0600). Never commit real values.
#
# --- Database (required) ---
# Postgres. On itsmini: role+db "runhub" on the local server (port 5433).
DATABASE_URL=postgres://runhub:CHANGEME@127.0.0.1:5433/runhub
#
# Days after an event's date before it moves to the archive (kept in the DB, hidden from the UI).
# ARCHIVE_GRACE_DAYS=7

# --- Server ---
# HOST controls the bind address:
#   127.0.0.1  local only (default)
#   0.0.0.0    localhost + Tailscale + LAN. Needed when a Cloudflare Tunnel
#              (cloudflared) or another container reaches the app from outside.
#   <tailscale ip>  only that interface
# HOST=0.0.0.0
# PORT=3300
#
# NOTE: .env is authoritative. pm2's `env` block would override it, which is why
# ecosystem.config.cjs deliberately sets no HOST/PORT.

# --- AI crawler (optional; see "racingschedule" in sources.json) ---
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL=bitnet-b1.58-2b-4t

# --- Credentials for login-based crawlers (opt-in) ---
# CHECKPOINTSPOT_EMAIL=
# CHECKPOINTSPOT_PASSWORD=
# FACEBOOK_EMAIL=
# FACEBOOK_PASSWORD=
# INSTAGRAM_EMAIL=
# INSTAGRAM_PASSWORD=

# --- Ads (flag-gated, not built yet) ---
ADS_ENABLED=false
